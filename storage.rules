rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userHasStore(storeId) {
      return storeId in request.auth.token.storeIds;
    }

    function isHq() {
      return request.auth != null && request.auth.token.role == 'hq';
    }

    function hasValidUploadMetadata(storeId) {
      return request.resource.metadata != null
        && request.resource.metadata.customMetadata != null
        && request.resource.metadata.customMetadata.storeId == storeId
        && request.resource.metadata.customMetadata.sha256 != null;
    }

    match /receipts/{storeId}/{yyyy}/{mm}/{receiptId}/{fileName} {
      allow read: if request.auth != null && (isHq() || userHasStore(storeId));

      allow write: if request.auth != null
        && userHasStore(storeId)
        && request.resource.contentType.matches('image/.*|application/pdf|application/json')
        && hasValidUploadMetadata(storeId);

      // TODO: validate fileName whitelist and size limits
    }
  }
}
